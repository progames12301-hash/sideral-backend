&time_control
 run_days = 0,
 run_hours = %RUN_HOURS%,
 run_minutes = %RUN_MINUTES%,
 start_year = %START_YEAR%,
 start_month = %START_MONTH%,
 start_day = %START_DAY%,
 start_hour = %START_HOUR%,
 end_year = %END_YEAR%,
 end_month = %END_MONTH%,
 end_day = %END_DAY%,
 end_hour = %END_HOUR%,
 interval_seconds = %INTERVAL_SECONDS%,
 input_from_file = .true.,
 history_interval = %HISTORY_INTERVAL%,
 frames_per_outfile = 1,
 restart = .false.,
 io_form_history = 2,
 io_form_restart = 2,
/

&domains
 time_step = 24,
 max_dom = 1,
 e_we = 320,
 e_sn = 370,
 e_vert = 45,
 num_metgrid_levels = %NUM_METGRID_LEVELS%,
 num_metgrid_soil_levels = %NUM_METGRID_SOIL_LEVELS%,
 p_top_requested = %P_TOP_REQUESTED%,
 dx = 4000,
 dy = 4000,
 grid_id = 1,
 parent_id = 1,
 i_parent_start = 1,
 j_parent_start = 1,
 parent_grid_ratio = 1,
 parent_time_step_ratio = 1,
 feedback = 1,
 smooth_option = 0,
/

&physics
 mp_physics = 16,
 ra_lw_physics = 4,
 ra_sw_physics = 4,
 bl_pbl_physics = 1,
 cu_physics = 0,
 sf_sfclay_physics = 1,
 sf_surface_physics = 2,
 do_radar_ref = 1,
/

&dynamics
 w_damping = 0,
 diff_opt = 1,
 km_opt = 4,
 diff_6th_opt = 0,
 diff_6th_factor = 0.12,
/

&bdy_control
 spec_bdy_width = 5,
 specified = .true.,
/

&namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 0,
/
