&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '%START_DATE%',
 end_date = '%END_DATE%',
 interval_seconds = %INTERVAL_SECONDS%,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id = 1,
 parent_grid_ratio = 1,
 i_parent_start = 1,
 j_parent_start = 1,
 e_we = 320,
 e_sn = 370,
 geog_data_res = 'lowres',
 dx = 4000,
 dy = 4000,
 map_proj = 'mercator',
 ref_lat = -28.3,
 ref_lon = -53.5,
 truelat1 = -24.0,
 truelat2 = -32.0,
 stand_lon = -53.5,
 geog_data_path = '%GEOG_DATA_PATH%',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
